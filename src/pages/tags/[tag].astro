---
/**
 * Tag aggregation — default locale (English): /tags/<tag>
 * Non-default locales: src/pages/[locale]/tags/[tag].astro
 *
 * Only tags actually used by THIS locale's articles get a page (list
 * accuracy rule — no fallback to English content).
 */
import TagListPage from '~/components/article/TagListPage.astro';
import { defaultLocale, locales } from '~/i18n/routing';
import { slugifyTag, localesForTag, parseEntryId, getTagRedirects } from '~/lib/content';
import { languageAlternates, tagPath } from '~/lib/url';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const all = await getCollection('wiki');
  const isDev = import.meta.env.DEV;

  // Unique slugs per locale (slug may collide across labels — dedupe via Set).
  const slugsByLocale = new Map<string, Set<string>>();
  for (const locale of locales) {
    slugsByLocale.set(locale, new Set());
  }
  for (const entry of all) {
    if (entry.data.draft && !isDev) continue;
    const parsedId = parseEntryId(entry.id);
    if (!parsedId || !slugsByLocale.has(parsedId.locale)) continue;
    for (const tag of entry.data.tags) {
      const slug = slugifyTag(tag);
      if (slug) slugsByLocale.get(parsedId.locale)!.add(slug); // skip empty slugs (blank tags)
    }
  }

  // Folded tags get a 301 to their article instead of a page (lib/tag-redirects.ts).
  const folded = await getTagRedirects(defaultLocale);
  return Array.from(slugsByLocale.get(defaultLocale) ?? [])
    .filter((tagSlug) => !folded.has(tagSlug))
    .map((tagSlug) => ({ params: { tag: tagSlug } }));
}

const tagSlug = Astro.params.tag ?? '';
// hreflang only for locales where the tag actually exists (no fallback).
const tagLocales = await localesForTag(tagSlug, { pagesOnly: true });
const alternates = languageAlternates((loc) => tagPath(tagSlug, loc), tagLocales);
---

<TagListPage locale={defaultLocale} tagSlug={tagSlug} alternates={alternates} />
