---
/**
 * Tag index page — cloud of all tags used in a locale, each linking to its
 * aggregation page. No English fallback (list accuracy rule, PRD §9.3):
 * a locale without tagged articles shows the empty state.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getTagRedirects, getTagsWithCounts, slugifyTag } from '~/lib/content';
import { pageTitle, simpleBreadcrumbJsonLd } from '~/lib/seo';
import { homeUrl, tagPath, tagsPath } from '~/lib/url';

interface Props {
  locale: Locale;
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, alternates = [] } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav;
const shared = ui.shared;

const title = shared.allTags;
const description = shared.tagsIndexDescription;

// Folded tags have no page of their own (they 301 to their article) — the
// index only lists real hub tags.
const folded = await getTagRedirects(locale);
const tags = (await getTagsWithCounts(locale)).filter(({ tag }) => !folded.has(slugifyTag(tag)));

const jsonLd = simpleBreadcrumbJsonLd({ pageLabel: title, path: tagsPath(locale), locale, homeLabel: nav.home });
---

<LocaleLayout
  locale={locale}
  title={pageTitle(title)}
  description={description}
  alternates={alternates}
  jsonLd={[jsonLd]}
>
  <div class="space-y-6">
    <header>
      <nav class="text-sm text-muted-foreground" aria-label="breadcrumb">
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <span class="mx-1">/</span>
        <span class="text-foreground">{title}</span>
      </nav>
      <div class="mt-2 flex items-center gap-3">
        <Icon name="lucide:tags" class="h-7 w-7 text-nav" />
        <h1 class="text-3xl font-extrabold tracking-tight">{title}</h1>
      </div>
      <p class="mt-2 max-w-2xl text-muted-foreground">{description}</p>
    </header>

    {
      tags.length === 0 ? (
        <div class="rounded-lg border border-dashed bg-card p-12 text-center">
          <Icon name="lucide:inbox" class="mx-auto h-10 w-10 text-muted-foreground" />
          <p class="mt-3 text-muted-foreground">{shared.noArticles}</p>
        </div>
      ) : (
        <div class="flex flex-wrap gap-3">
          {tags.map(({ tag, count }) => (
            <a
              href={tagPath(slugifyTag(tag), locale)}
              class="card inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm text-foreground"
            >
              <Icon name="lucide:hash" class="h-3.5 w-3.5" />
              {tag}
              <span class="text-xs text-muted-foreground">
                {count} {shared.articlesCount}
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</LocaleLayout>
