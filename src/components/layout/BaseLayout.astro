---
/**
 * BaseLayout — the root <html> + <head> shell shared by every page.
 *
 * Responsibilities:
 *   - <html lang> and theme class (no FOUC via inline script)
 *   - global <head>: charset, viewport, title template, description, og/twitter defaults
 *   - Organization JSON-LD (every page)
 *   - global styles
 *
 * Pages should wrap themselves in LocaleLayout (which wraps this), not call this directly.
 */
import '~/styles/globals.css';
import { site, siteUrl } from '~/config/site';
import { defaultLocale, locales, OG_LOCALE_MAP, type Locale } from '~/i18n/routing';
import { organizationJsonLd } from '~/lib/seo';
import JsonLd from '~/components/seo/JsonLd.astro';
import CookieConsent from './CookieConsent.astro';
import { getUi } from '~/i18n/ui';

interface Props {
  title: string;
  description: string;
  locale: string;
  /** Per-page alternates for hreflang. */
  alternates?: Array<{ hreflang: string; href: string }>;
  /** og:image override (absolute URL). Defaults to hero.webp. */
  image?: string;
  /** Optional extra JSON-LD objects to inject (WebSite, Article, etc.). */
  jsonLd?: Record<string, unknown>[];
  /** Set to true on article pages for og:type=article. */
  article?: boolean;
  /** When true, emit <meta name="robots" content="noindex"> to exclude from search. */
  noindex?: boolean;
  /**
   * Absolute canonical URL override. Used by single-article hub pages, which
   * are thin duplicates of their only child article — pointing the hub's
   * canonical at the article consolidates signals on one URL instead of two
   * ranking against each other.
   */
  canonical?: string;
  /**
   * Real dimensions of `image` (px). Omitted for article covers whose size we
   * don't know — a WRONG og:image:width/height makes scrapers mis-crop the
   * share card; absent metas let them measure the image themselves.
   */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Article publish date (og:type=article pages) → article:published_time. */
  articlePublished?: Date;
  /** Article last-modified date → article:modified_time. */
  articleModified?: Date;
  /**
   * Locale of the MAIN CONTENT. Defaults to `locale` (the UI chrome). Pass
   * `servedLocale` on English-fallback pages so <html lang> / og:locale match
   * the body language instead of the chrome language.
   */
  contentLocale?: Locale;
  /**
   * Override the <title> suffix (defaults to site.name). Pass an empty string
   * to suppress the suffix entirely (e.g. for the project landing page where
   * the site.name is the demo game, not the project itself).
   */
  titleSuffix?: string;
  /**
   * Full override of the consent-banner strings + privacy link. The marketing
   * landing passes this for `zh`: landing-only htmlLangs have no wiki locale
   * JSON (labels would fall back to English) and no localized legal page
   * (the derived /zh/privacy-policy/ would 404).
   */
  consent?: {
    title: string;
    text: string;
    accept: string;
    decline: string;
    privacyLabel: string;
    privacyHref: string;
  };
}

const {
  title,
  description,
  locale,
  alternates = [],
  image = `${siteUrl}/images/hero.webp`,
  jsonLd = [],
  article = false,
  noindex = false,
  canonical,
  titleSuffix,
  ogImageWidth,
  ogImageHeight,
  articlePublished,
  articleModified,
  contentLocale,
  consent,
} = Astro.props;

// Language of the main content (falls back to the UI locale).
const mainLocale = contentLocale ?? locale;
const ogLocaleMap = OG_LOCALE_MAP as Record<string, string>;
const ogLocale = ogLocaleMap[mainLocale] ?? mainLocale;

const suffix = titleSuffix !== undefined ? titleSuffix : site.name;
// Skip suffixing when the title already carries any identity marker —
// pageTitle() may have appended the short suffix ("X — AQ Wiki"), the title
// may contain the game name, or a caller passed a pre-suffixed string.
const hasIdentity =
  title.includes(suffix) ||
  title.includes(site.name) ||
  title.includes(site.shortName) ||
  title.includes(site.game.name);
const fullTitle = suffix && !hasIdentity ? `${title} — ${suffix}` : title;
const orgJsonLd = organizationJsonLd();

// Strip ANY known locale prefix (built from routing.ts so new locales keep
// x-default pointing at the default-locale URL — a hardcoded en|ja list
// would silently break for forks that add languages).
const localePrefixRe = new RegExp(`^/(${locales.join('|')})(?=/|$)`);

// x-default should point at the default-language version when one exists.
// When the caller passes alternates we derive it from them instead of blind
// prefix-stripping — that way a page whose default-locale URL was never built
// (e.g. a ja-only article, or /zh/landing) never emits a dead x-default.
const defaultAlt = alternates.find((a) => a.hreflang === defaultLocale);
const xDefaultHref = defaultAlt
  ? defaultAlt.href
  : alternates.length > 0
    ? alternates[0].href
    : `${siteUrl}${Astro.url.pathname.replace(localePrefixRe, '')}`;

// Optional analytics / verification / ads (env-var gated — empty = not injected).
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;

// Consent banner labels: wiki locales derive them from the locale JSON
// (hardcoded English fallbacks for a locale whose JSON hasn't been translated
// yet); landing-only htmlLangs (zh) pass a full override via LandingLayout.
const sharedStrings = getUi(locale).shared;
const consentLabels = consent
  ? { title: consent.title, text: consent.text, accept: consent.accept, decline: consent.decline }
  : {
      title: sharedStrings.consentTitle ?? 'Cookies',
      text: sharedStrings.consentText ?? 'We use cookies for analytics and ads.',
      accept: sharedStrings.accept ?? 'Accept',
      decline: sharedStrings.decline ?? 'Decline',
    };
// Consent banner links to the localized privacy policy (informed consent).
// The link must point at a page that EXISTS — landing-only htmlLangs like zh
// have no legal page, so clamp the fallback to a real wiki locale.
const consentLocale = (locales as readonly string[]).includes(locale) ? locale : defaultLocale;
const footerStrings = getUi(locale).footer;
const privacyHref =
  consent?.privacyHref ??
  (consentLocale === defaultLocale ? '/privacy-policy/' : `/${consentLocale}/privacy-policy/`);
const privacyLabel = consent?.privacyLabel ?? footerStrings.privacyPolicy ?? 'Privacy Policy';
---

<!doctype html>
<html lang={mainLocale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* pnpm gen-assets regenerates these in place with the live brand color.
        SVG first (sharp modern browsers), 32px PNG fallback; the legacy
        favicon.ico stays in public/ but is never referenced (sharp can't
        emit ICO — see scripts/gen-assets.ts). */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      /* Google Discover large-image previews require explicit permission —
         without this, covers never surface as large preview images (v2.0). */
      <meta name="robots" content="max-image-preview:large" />
    )}
    <link rel="canonical" href={canonical ?? new URL(Astro.url.pathname, siteUrl).href} />

    {/* hreflang alternates */}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    {/* Open Graph */}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {
      // Only declare dimensions we actually know: the default hero has fixed
      // site dims; per-article covers pass their real size; unknown = omit
      // (wrong dims make scrapers mis-crop the share card).
      (ogImageWidth && ogImageHeight) || image === `${siteUrl}/images/hero.webp` ? (
        <>
          <meta
            property="og:image:width"
            content={String(ogImageWidth ?? site.ogImageWidth)}
          />
          <meta
            property="og:image:height"
            content={String(ogImageHeight ?? site.ogImageHeight)}
          />
        </>
      ) : null
    }
    <meta property="og:url" content={canonical ?? new URL(Astro.url.pathname, siteUrl).href} />
    <meta property="og:site_name" content={site.name} />
    {/* OG wants language_TERRITORY (en_US / ja_JP), not a bare ISO code. */}
    <meta property="og:locale" content={ogLocale} />
    {alternates
      .filter((alt) => alt.hreflang !== mainLocale && alt.hreflang !== 'x-default')
      .map((alt) => (
        <meta property="og:locale:alternate" content={ogLocaleMap[alt.hreflang] ?? alt.hreflang} />
      ))}
    {article && articlePublished && (
      <meta property="article:published_time" content={articlePublished.toISOString()} />
    )}
    {article && (articleModified ?? articlePublished) && (
      <meta
        property="article:modified_time"
        content={(articleModified ?? articlePublished)?.toISOString()}
      />
    )}

    {/* Twitter */}
    {/* Every page's og:image is ≥1200px wide (hero 1200×630, article covers
        1200×675) — always claim the large card (Aniimo: a global "summary"
        undersold every share). */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {/* Theme color (browser chrome) is injected by the runtime script below —
        meta content is a plain string where var() never resolves. */}

    {/* Google Search Console verification (optional) */}
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    {/*
      Analytics / AdSense are injected DYNAMICALLY (consent-gated).
      BaseLayout only defines the loader; CookieConsent.astro calls it after
      the visitor accepts. See GDPR note in AGENTS.md. No tracking env vars
      → this block renders nothing → zero JS.
    */}
    {(gaId || adsenseClient) && (
      <script is:inline define:vars={{ gaId, adsenseClient }}>
        window.__awLoadTrackers = () => {
          if (window.__awTrackersLoaded) return;
          window.__awTrackersLoaded = true;
          if (gaId) {
            const s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          }
          if (adsenseClient) {
            const s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src =
              'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' +
              adsenseClient;
            document.head.appendChild(s);
          }
        };
      </script>
    )}

    {/*
      Cloudflare Web Analytics (optional) — cookieless, so unlike GA/AdSense
      it needs no consent gate. Empty token = nothing injected, zero JS.
    */}
    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      ></script>
    )}

    {/* JSON-LD: Organization (global) + any page-specific */}
    <JsonLd data={orgJsonLd} />
    {jsonLd.map((d) => <JsonLd data={d} />)}

    {/* No-FOUC theme init — runs before first paint. */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {
          /* storage unavailable */
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || stored === 'black' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
          if (stored === 'black') document.documentElement.classList.add('black');
        }
      })();
    </script>

    {/* Keep <meta name="theme-color"> in sync with the active theme color.
        Meta content is a plain string — var() never resolves there, so the
        browser chrome color is derived from the computed --brand-text at
        runtime (initial paint + every theme toggle, via class observer). */}
    <script is:inline>
      (() => {
        const meta = document.createElement('meta');
        meta.name = 'theme-color';
        document.head.appendChild(meta);
        const apply = () => {
          const v = getComputedStyle(document.documentElement)
            .getPropertyValue('--brand-text')
            .trim();
          if (v) meta.setAttribute('content', `hsl(${v})`);
        };
        apply();
        new MutationObserver(apply).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
    {/* Consent banner — only rendered when tracking env vars are set. */}
    {(gaId || adsenseClient) && (
      <CookieConsent
        labels={{
          title: consentLabels.title,
          text: consentLabels.text,
          accept: consentLabels.accept,
          decline: consentLabels.decline,
        }}
        privacyHref={privacyHref}
        privacyLabel={privacyLabel}
      />
    )}
  </body>
</html>
